{
  "description": "Herd hooks: the Stop gate blocks finishing without fresh passing evidence; before `herd init`, a Bash hook records the files the session already edited, for red first; the optional lint hook feeds lint errors back after edits; while a task is active, the guard denies edits to secrets and Herd's state files and irreversible git and GitHub commands; when the herd-reviewer subagent stops, the review hook records its review from the session logs.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/herd.py\" gate",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/herd.py\" lint",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/herd.py\" preinit",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/herd.py\" guard",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^herd:herd-reviewer$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/herd.py\" review-hook",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
